# Сборка PyInstaller
/build/
/dist/
*.spec
# …но macOS-spec нужен в репозитории (его использует облачная сборка)
!DNSManager_macos.spec

# Сборочное venv
/.venv-build/
/.venv-macos/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Логи/настройки приложения (на случай локальной отладки рядом с кодом)
*.log
settings.json

# Локальные bat-скрипты (сборка/служебные) — в репозиторий не публикуются
*.bat

# Распаковка стороннего DNS Jumper (для изучения, не публикуется)
_dnsjumper_inspect/
*.zip
